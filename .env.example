# Crate Finder 환경변수 예시 — 이 파일만 커밋한다(.env는 커밋 금지).
# 로컬: 이 파일을 .env(또는 .env.local)로 복사해 값을 채운다.
# 배포(Vercel): Project Settings → Environment Variables에 등록한다. 자세한 건 docs/DEPLOY.md.

# ── 필수 ──────────────────────────────────────────────────────────
# YouTube Data API v3 키. 서버 전용 — 절대 NEXT_PUBLIC_ 접두사로 노출하지 않는다.
# 미설정 시 실제 플레이리스트 조회가 안 되고 스텁/데모로만 동작한다.
YOUTUBE_API_KEY=

# ── 선택 ──────────────────────────────────────────────────────────
# 가격 조회 모드. 기본 mock(외부 가격 API 없이 모의 동작). 미설정 시 mock.
PRICE_PROVIDER_MODE=mock

# ── 미사용/예약(현재 코드가 읽지 않음 — 향후용) ───────────────────────
# DATABASE_URL: 현재 영속화는 브라우저 localStorage. DB 미사용(ADR-004). 향후 도입 시 사용.
DATABASE_URL=
# NEXT_PUBLIC_APP_URL: 현재 코드 미사용. 향후 절대 URL/메타데이터용 예약.
NEXT_PUBLIC_APP_URL=
# MAX_XML_FILE_SIZE_MB: 현재 코드상 업로드 한도는 20MB로 고정(미배선). 예약.
# 참고: Vercel 서버리스 함수는 요청 본문이 ~4.5MB로 제한된다(docs/DEPLOY.md 참조).
MAX_XML_FILE_SIZE_MB=20
